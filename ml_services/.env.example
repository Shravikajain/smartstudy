# Copy to ml_services/.env. Never commit .env.
OLLAMA_API_KEY=your-ollama-cloud-api-key

# Only needed when running the ML service outside Docker (Compose passes it in).
# Must match the backend's ML_INTERNAL_KEY.
# ML_INTERNAL_KEY=

# Set to false to skip preloading the AI-detector, Whisper and embedding models at startup.
# ML_WARMUP=true
# Set to false to group past-paper questions by shared words only.
# ML_EMBEDDINGS=true
