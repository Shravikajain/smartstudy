# Copy this file to .env and replace every placeholder before starting Docker Compose.
POSTGRES_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-at-least-32-random-bytes-base64-encoded
ML_INTERNAL_KEY=replace-with-a-long-random-shared-service-key
OLLAMA_API_KEY=
OLLAMA_HOST=https://ollama.com
OLLAMA_MODEL=gpt-oss:120b
OLLAMA_THINK=low
FRONTEND_PORT=3001
