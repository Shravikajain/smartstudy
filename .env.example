# Copy to .env and replace every value. Never commit .env.
# Generate secrets in PowerShell with:
#   $bytes = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($bytes); [Convert]::ToBase64String($bytes)

POSTGRES_PASSWORD=change-me
JWT_SECRET=generate-a-base64-secret
ML_INTERNAL_KEY=generate-a-different-base64-secret

FRONTEND_PORT=3001

# Optional ML overrides (defaults shown)
# OLLAMA_HOST=https://ollama.com
# OLLAMA_MODEL=gpt-oss:120b
# OLLAMA_THINK=low
# WHISPER_MODEL=base
